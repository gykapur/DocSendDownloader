{
  "name": "Slide Deck Downloader",
  "version": "2.1",
  "description": "Download DocSend slide decks and Google Slides presentations as PDF",
  "permissions": ["declarativeNetRequestWithHostAccess", "scripting", "tabs"],
  "host_permissions": [
    "*://*.docsend.com/",
    "*://*.cloudfront.net/*",
    "*://*.docsend.dropbox.com/*",
    "*://*.google.com/*",
    "*://*.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "action": {
    "default_title": "Download slide deck as PDF"
  },
  "icons": {
    "16": "./assets/icon16.png",
    "48": "./assets/icon48.png",
    "128": "./assets/icon128.png"
  },
  "manifest_version": 3
}
